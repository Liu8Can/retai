{
    "name": "Tai Sentry",
    "description": "Tai网页浏览数据统计拓展",
    "version": "0.1",
    "icons": {
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "manifest_version": 2,
    "browser_action": {
        "default_icon": "icons/socket-inactive.png"
    },
    "background": {
        "scripts": ["background.js"]
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "tai-sentry@retai.app",
            "strict_min_version": "115.0"
        }
    },
    "permissions": [
        "tabs"
    ]
}
